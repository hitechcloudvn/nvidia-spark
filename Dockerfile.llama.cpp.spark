# =============================================================================
# Dockerfile.llama.cpp.spark — Ảnh llama.cpp CUDA 13 cho NVIDIA DGX Spark
#                               llama.cpp CUDA 13 image for NVIDIA DGX Spark
#
# EN: Adapted from llama.cpp .devops/cuda.Dockerfile. Build with the llama.cpp
#     source tree as context and --target full — see
#     build-llama.cpp-cuda13-docker.sh (targets: base/full/light/server).
# VI: Chuyển thể từ .devops/cuda.Dockerfile của llama.cpp. Build với mã nguồn
#     llama.cpp làm context và --target full — xem
#     build-llama.cpp-cuda13-docker.sh (các target: base/full/light/server).
#
# Repo: https://github.com/hitechcloudvn/nvidia-spark
#       https://gitlab.com/hitechcloudvn/nvidia-spark
# =============================================================================
ARG UBUNTU_VERSION=24.04
# This needs to generally match the container host's environment.
ARG CUDA_VERSION=13.0.2
# Target the CUDA build image
ARG BASE_CUDA_DEV_CONTAINER=nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}

ARG BASE_CUDA_RUN_CONTAINER=nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu${UBUNTU_VERSION}

FROM ${BASE_CUDA_DEV_CONTAINER} AS build

# CUDA architecture to build for (defaults to all supported archs)
ARG CUDA_DOCKER_ARCH=121

ENV LD_LIBRARY_PATH=/usr/local/cuda-13/compat

RUN apt-get update && \
    apt-get install -y build-essential cmake python3 python3-pip git libcurl4-openssl-dev libgomp1

WORKDIR /app

COPY . .

RUN cmake -B build -DGGML_CUDA=ON -DLLAMA_CURL=ON -DCMAKE_CUDA_ARCHITECTURES="${CUDA_DOCKER_ARCH}" && \
    cmake --build build --config Release -j$(nproc)


RUN mkdir -p /app/lib && \
    find build -name "*.so*" -exec cp -P {} /app/lib \;

RUN mkdir -p /app/full \
    && cp build/bin/* /app/full \
    && cp *.py /app/full \
    && cp -r gguf-py /app/full \
    && cp -r requirements /app/full \
    && cp requirements.txt /app/full \
    && cp .devops/tools.sh /app/full/tools.sh

## Base image
FROM ${BASE_CUDA_RUN_CONTAINER} AS base

# OCI metadata — inherited by the full/light/server targets below
# Siêu dữ liệu OCI — kế thừa bởi các target full/light/server bên dưới
LABEL org.opencontainers.image.title="llama.cpp (spark)" \
      org.opencontainers.image.description="llama.cpp CUDA 13 image for NVIDIA DGX Spark (sm_121)" \
      org.opencontainers.image.source="https://github.com/hitechcloudvn/nvidia-spark" \
      org.opencontainers.image.url="https://github.com/hitechcloudvn/nvidia-spark" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="HiTechCloud (hitechcloudvn)"

ENV LD_LIBRARY_PATH=/usr/local/cuda-13/compat

RUN apt-get update \
    && apt-get install -y libgomp1 curl\
    && apt autoremove -y \
    && apt clean -y \
    && rm -rf /tmp/* /var/tmp/* \
    && find /var/cache/apt/archives /var/lib/apt/lists -not -name lock -type f -delete \
    && find /var/cache -type f -delete

COPY --from=build /app/lib/ /app

### Full
FROM base AS full

COPY --from=build /app/full /app

WORKDIR /app

RUN apt-get update \
    && apt-get install -y \
    git \
    python3 \
    python3-pip \
    pipx \
    && pipx ensurepath \
    && pipx install uv \
    && ~/.local/bin/uv pip install --system --break-system-packages --upgrade pip setuptools wheel \
    && ~/.local/bin/uv pip install --system --break-system-packages -r requirements/requirements-convert_legacy_llama.txt \
    && ~/.local/bin/uv pip install --system --break-system-packages -r requirements/requirements-compare-llama-bench.txt \
    && ~/.local/bin/uv pip install --system --break-system-packages -r requirements/requirements-tool_bench.txt \
    && ~/.local/bin/uv pip install --system --break-system-packages -r requirements.txt \
    && apt autoremove -y \
    && apt clean -y \
    && rm -rf /tmp/* /var/tmp/* \
    && find /var/cache/apt/archives /var/lib/apt/lists -not -name lock -type f -delete \
    && find /var/cache -type f -delete


ENTRYPOINT ["/app/tools.sh"]

### Light, CLI only
FROM base AS light

COPY --from=build /app/full/llama-cli /app

WORKDIR /app

ENTRYPOINT [ "/app/llama-cli" ]

### Server, Server only
FROM base AS server

ENV LLAMA_ARG_HOST=0.0.0.0

COPY --from=build /app/full/llama-server /app

WORKDIR /app

HEALTHCHECK CMD [ "curl", "-f", "http://localhost:8080/health" ]

ENTRYPOINT [ "/app/llama-server" ]

# =============================================================================
# .env.example — Mẫu biến môi trường / Environment variable template
#
# EN: Copy to `.env` and fill in your values. `.env` is gitignored — never
#     commit real keys. / VI: Copy thành `.env` và điền giá trị. `.env` đã nằm
#     trong .gitignore — không bao giờ commit khoá thật.
#
# cp .env.example .env
#
# Repo: https://github.com/hitechcloudvn/nvidia-spark
#       https://gitlab.com/hitechcloudvn/nvidia-spark
# =============================================================================

# --- Secrets / Bí mật ---
HF_TOKEN=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# --- Identity for Vibe Kanban PRs / Danh tính khi tạo PR qua Vibe Kanban ---
GITHUB_USER=
GITHUB_EMAIL=

# --- Agent routing / Định tuyến agent ---
# max-inference | llama.cpp
AGENT_INFERENCE_SERVER=max-inference
AGENT_MAIN_MODEL=noctrex/MiniMax-M2-REAP-139B-A10B-MXFP4_MOE-GGUF
AGENT_BACKGROUND_MODEL=noctrex/MiniMax-M2-REAP-139B-A10B-MXFP4_MOE-GGUF

# --- Ports / Cổng ---
VIBE_KANBAN_PORT=8888

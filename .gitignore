# =============================================================================
# .gitignore — Bỏ qua file không cần theo dõi / Ignore files not to be tracked
#
# EN: Tuned for this shell/Docker toolkit repo (not a Go project).
# VI: Chỉnh cho repo công cụ shell/Docker này (không phải dự án Go).
#
# Repo: https://github.com/hitechcloudvn/nvidia-spark
#       https://gitlab.com/hitechcloudvn/nvidia-spark
# =============================================================================

# env file with secrets / file .env chứa bí mật
.env

# logs / file log
*.log
logs/

# OS junk / file rác của hệ điều hành
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE / trình soạn thảo
.idea/
.vscode/
*.swp
*.swo
*~

# agents / trợ lý AI
.aider*

# local build artifacts / sản phẩm build cục bộ
dist/
build/
*.tar
*.tar.gz
*.tgz
